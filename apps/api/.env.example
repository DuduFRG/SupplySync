# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

DATABASE_URL=postgresql://supplysync:supplysync_dev_only@127.0.0.1:5432/supplysync?schema=public

# Segredos (mínimo 32 caracteres cada, todos diferentes entre si)
JWT_ACCESS_SECRET=
TOKEN_HASH_SECRET=
PASSWORD_PEPPER=

# Quantos proxies confiáveis existem na frente da API (ex.: 1 com Cloudflare -> API).
# Define de onde vem o IP real usado no rate limiting.
TRUST_PROXY_HOPS=0

# Origens web permitidas (separadas por vírgula). O app nativo não usa CORS.
CORS_ORIGINS=

# Redis para rate limiting distribuído (obrigatório em produção com mais de uma instância)
REDIS_URL=

# Antibot: turnstile | none (none só é aceito fora de produção)
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET_KEY=

# E-mail transacional: console | resend (console só fora de produção)
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM="SupplySync <no-reply@supplysync.app>"

# Armazenamento de fotos (diretório privado, nunca servido estaticamente)
STORAGE_DIR=./storage

# Opcional: token de acesso do Expo Push (recomendado em produção)
EXPO_ACCESS_TOKEN=

// SupplySync: modelo de dados.
// Todo dado de uma casa carrega householdId, e toda consulta da API filtra por ele
// (defesa contra IDOR/BOLA). IDs são UUID v4, nunca sequenciais.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  FAMILY
}

enum Role {
  OWNER
  MEMBER
}

enum ItemStatus {
  OK
  LOW
  OUT
}

enum BuyerMode {
  ROTATION
  PREFERRED
  FAIR
}

enum Category {
  CLEANING
  HYGIENE
  KITCHEN
  PET
  BABY
  HOME
  OTHER
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  displayName     String
  emailVerifiedAt DateTime?
  /// Incrementar invalida todos os access tokens emitidos.
  tokenVersion    Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  emailCodes    EmailCode[]
  pushTokens    PushToken[]
  purchases     Purchase[]     @relation("PurchaseBuyer")
  shares        PurchaseShare[]
}

model EmailCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  /// HMAC-SHA256 do código. O código em si nunca é salvo.
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// HMAC-SHA256 do token opaco.
  tokenHash String    @unique
  /// Todos os tokens de uma mesma sessão compartilham a família (detecção de reuso).
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  invites      Invite[]
  items        Item[]
  statusEvents StatusEvent[]
  photos       Photo[]
  purchases    Purchase[]
  settlements  Settlement[]
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  householdId String   @db.Uuid
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  maxUses     Int
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Item {
  id                String     @id @default(uuid()) @db.Uuid
  householdId       String     @db.Uuid
  name              String
  category          Category
  unit              String?
  critical          Boolean    @default(false)
  status            ItemStatus @default(OK)
  buyerMode         BuyerMode  @default(ROTATION)
  preferredUserId   String?    @db.Uuid
  typicalPriceCents Int?
  lastBuyerId       String?    @db.Uuid
  statusChangedAt   DateTime   @default(now())
  statusChangedById String?    @db.Uuid
  lastPhotoId       String?    @db.Uuid
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  statusEvents StatusEvent[]
  purchases    Purchase[]

  @@index([householdId, archivedAt])
}

model StatusEvent {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @db.Uuid
  itemId      String     @db.Uuid
  status      ItemStatus
  userId      String?    @db.Uuid
  note        String?
  photoId     String?    @db.Uuid
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([householdId])
}

model Photo {
  id           String   @id @default(uuid()) @db.Uuid
  householdId  String   @db.Uuid
  uploadedById String   @db.Uuid
  /// Nome gerado pelo servidor. Nunca derivado de entrada do usuário.
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Purchase {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  itemId      String?  @db.Uuid
  title       String
  buyerId     String   @db.Uuid
  createdById String   @db.Uuid
  amountCents Int
  quantity    Int      @default(1)
  note        String?
  purchasedAt DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  buyer     User            @relation("PurchaseBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  shares    PurchaseShare[]

  @@index([householdId, purchasedAt])
}

model PurchaseShare {
  purchaseId String @db.Uuid
  userId     String @db.Uuid
  shareCents Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([purchaseId, userId])
  @@index([userId])
}

model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  fromUserId  String   @db.Uuid
  toUserId    String   @db.Uuid
  amountCents Int
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
}

# Somente variáveis PÚBLICAS (prefixo EXPO_PUBLIC_). Elas vão para dentro do app.
# Nunca coloque chaves secretas aqui.

# Em aparelho físico use o IP da sua máquina na rede local, ex.: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Cloudflare Turnstile (chave de SITE, pública). A chave secreta fica só na API.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Domínio cadastrado no widget Turnstile (ex.: https://supplysync.app)
EXPO_PUBLIC_TURNSTILE_BASE_URL=
